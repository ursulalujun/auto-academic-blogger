# Optional local environment notes for auto-academic-blogger
#
# This repo is mostly file-based and does not require a mandatory .env file.
# Keep this file as a reminder for paths or local conventions you may want
# to standardize in your own setup.

# Where generated paper digests and Xiaohongshu assets are stored.
ACADEMIC_BLOGGER_WORKSPACE=/Users/<you>/Documents/Playground

# Where your local Codex skills directory lives.
CODEX_HOME=/Users/<you>/.codex

# Optional: the daily paper root used by your own prompts or scripts.
DAILY_PAPER_DIR=/Users/<you>/Documents/Playground/daily_paper

# Optional: preferred browser for Xiaohongshu publishing.
BROWSER=Safari

# Optional: if you keep a fixed Safari window for publishing, record its id here
# and pass it into publish scripts when needed.
SAFARI_PUBLISH_WINDOW_ID=
